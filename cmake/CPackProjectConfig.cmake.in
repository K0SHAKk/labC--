# CPack reads this once for each generator, after selecting the build configuration.
if(NOT CPACK_BUILD_CONFIG)
    set(CPACK_BUILD_CONFIG "@CMAKE_BUILD_TYPE@")
endif()
if(NOT CPACK_BUILD_CONFIG)
    set(CPACK_BUILD_CONFIG Release)
endif()
set(CPACK_PACKAGE_FILE_NAME
    "@CPACK_PACKAGE_NAME@-@PROJECT_VERSION@-@CMAKE_SYSTEM_NAME@-@CMAKE_SYSTEM_PROCESSOR@-${CPACK_BUILD_CONFIG}")

if(CPACK_GENERATOR STREQUAL "DEB")
    set(CPACK_PACKAGING_INSTALL_PREFIX "/opt/physics-lab5")
endif()
